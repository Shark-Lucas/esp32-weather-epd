# Copy to .dev.vars for local development. This example contains no real keys.
# DEVICE_TOKEN accepts 32-256 characters; hexadecimal encoding is not required.
OPENWEATHER_API_KEY="replace-with-your-openweather-key"
DEVICE_TOKEN="replace-with-a-random-token-of-at-least-32-characters"
# Local quota enforcement is optional; upstream 429 cooldown always applies.
OWM_BUDGET_ENFORCED="false"
OWM_BUDGET_CONFIRMED="false"
OWM_BUDGET_UNIT="request"
OWM_BUDGET_RESET_UTC_HOUR="0"
OWM_DAILY_BUDGET="0"
